<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="playwright-testng" parallel="none">
  <listeners>
    <listener class-name="listener.FrameworkTestListener"/>
    <listener class-name="listener.AllureStepScreenshotListener"/>
  </listeners>
  <test name="login">
    <groups>
      <run>
        <include name="smoke"/>
        <include name="regression"/>
      </run>
    </groups>
    <packages>
      <package name="tests"/>
    </packages>
  </test>
</suite>
